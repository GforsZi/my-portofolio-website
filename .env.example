# Copy this file to `.env` and fill in your real values.
# Get the connection string from: Supabase Dashboard → Project Settings → Database → Connection string.

# Session pooler (default). Swap port to 6543 (transaction pooler) if you hit connection limits.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
