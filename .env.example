# Copy this file to `.env` and fill in your real values.
# Get the connection strings from: Supabase Dashboard → Project Settings → Database → Connection string.
#
# - DATABASE_URL = transaction pooler (port 6543, `?pgbouncer=true`). Used by the app at runtime
#   via the PrismaPg driver adapter in lib/prisma.ts. Best for serverless/Next.js requests.
# - DIRECT_URL  = session pooler (port 5432, no pgbouncer param). Used by the Prisma CLI
#   (prisma.config.ts datasource.url) for `db:push` / `migrate` / `studio`, because Prisma 7
#   removed `directUrl` — the CLI always connects with the `url` in prisma.config.ts.

# Runtime (transaction pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI / migrations (session pooler).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
